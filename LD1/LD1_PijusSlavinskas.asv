% Pijus Slavinskas EF-25/2 2026-09-11
%%
%Paparastas skriptas

x = 1:32;
y = x.^2;

plot(x, y, 'o-r', x, y/3, 'xb') %[output:5c46f3ab]
title('Dvi funkcijos') %[output:5c46f3ab]
xlabel('X-ai') %[output:5c46f3ab]
ylabel('F_1 [-o-]   |   F_2 [-x-]') %[output:5c46f3ab]
%%
help sin %[output:2b06fdbb]
help plot %[output:7220c900]
help title %[output:3569bda5]

doc sin
doc plot
doc title

docsearch sin
docsearch plot %[output:8f0cd40b]
docsearch title
%%
y = linspace(1, 3, 3)  %[output:8c4d3632]
size(y)  %[output:36535dab]
max(y) %[output:6da92bd7]

help linspace %[output:61741dfe]
help size %[output:05a2edb7]
help max %[output:49a90fcb]
%%
%Papildoma

N = 7;
y = linspace((N+1), (N+4), 0.5) %[output:7ced0bbc]

